{
  "name": "AK Smarts PDF",
  "short_name": "AK Smarts PDF",
  "description": "Read, edit, sign (e-Sign and DSC), convert and protect PDFs.",
  "id": "/",
  "start_url": "/app",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone"
  ],
  "orientation": "any",
  "background_color": "#0a47c4",
  "theme_color": "#145447",
  "categories": [
    "productivity",
    "business",
    "utilities"
  ],
  "icons": [
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "file_handlers": [
    {
      "action": "/open",
      "accept": {
        "application/pdf": [
          ".pdf"
        ]
      },
      "icons": [
        {
          "src": "/icons/pdf-file-16.png",
          "sizes": "16x16",
          "type": "image/png"
        },
        {
          "src": "/icons/pdf-file-32.png",
          "sizes": "32x32",
          "type": "image/png"
        },
        {
          "src": "/icons/pdf-file-48.png",
          "sizes": "48x48",
          "type": "image/png"
        },
        {
          "src": "/icons/pdf-file-64.png",
          "sizes": "64x64",
          "type": "image/png"
        },
        {
          "src": "/icons/pdf-file-128.png",
          "sizes": "128x128",
          "type": "image/png"
        },
        {
          "src": "/icons/pdf-file-256.png",
          "sizes": "256x256",
          "type": "image/png"
        }
      ],
      "launch_type": "single-client"
    }
  ],
  "share_target": {
    "action": "/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [
        {
          "name": "pdf",
          "accept": [
            "application/pdf",
            ".pdf"
          ]
        }
      ]
    }
  },
  "launch_handler": {
    "client_mode": [
      "focus-existing",
      "auto"
    ]
  }
}
